# Copy to .env.local for local dev (Vite loads .env.local automatically and
# it's gitignored by the default Vite .gitignore — double check before committing).

# Shows the "Metrics" card on the landing page and enables the /metrics route.
# Off by default so a production build doesn't advertise the dashboard unless
# this deployment wants it — the backend gates /metrics/* independently too
# (see backend/.env.example: METRICS_ADMIN_TOKEN).
VITE_METRICS_ENABLED=true

# Base URL of the Jaeger UI, for "open trace" links on the dashboard. Leave
# unset in production (Render has no public Jaeger) — links are hidden
# instead of pointing at a dead localhost URL.
VITE_JAEGER_URL=http://localhost:16686

# Only needed if the backend's METRICS_ADMIN_TOKEN is set for this deployment.
# VITE_METRICS_ADMIN_TOKEN=
