# Copy to .env and fill in. .env is gitignored — never commit real secrets.

OPENAI_API_KEY=sk-...

# --- Observability -----------------------------------------------------------

# Master switch for exporting traces to Jaeger. The in-process metrics rollup
# (SQLite + /metrics/*) keeps working even when this is off. Never required
# for the app to start — a Jaeger that isn't reachable just means no export.
TRACING_ENABLED=1

# Where Jaeger accepts OTLP over HTTP. docker-compose.yml points this at the
# `jaeger` service; running Jaeger locally without Docker, this is the default.
OTLP_ENDPOINT=http://localhost:4318

# SQLite file the metrics rollup is written to.
METRICS_DB_PATH=metrics.db

# Gates GET/DELETE /metrics/*. Unset: only requests from localhost are allowed
# (local dev). Set: every request must send this value as an X-Metrics-Token
# header or ?token= query param. Set this before exposing the backend publicly.
# METRICS_ADMIN_TOKEN=
